# Copy to .env.local for local dev. NEVER commit real values (this repo is public).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Supabase — the Vercel ↔ Supabase integration fills these in automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline (server only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
YOU_API_KEY=
FIRECRAWL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
JEV_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5
# RESEARCH_PARALLEL=12
# MATCH_PARALLEL=10
# PIPELINE_TIMING=0   # turn off per-call timing logs
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash
